{
  "id": "event-timers",
  "name": "Event Timers",
  "version": "0.9.1",
  "apiVersion": 2,
  "author": "A2 Tools",
  "description": "Countdowns to events and bosses in your server's time, with alerts before the ones you pick, and any timer pinned as an icon you place anywhere.",
  "permissions": [
    "storage",
    "events:character",
    "window",
    "feed:boss-timers",
    "widgets",
    "decoder:timed-event"
  ],
  "decoders": [
    {
      "name": "timed-event",
      "opcode": "01 60",
      "immediate": true,
      "fields": [
        {
          "name": "kind",
          "type": "u8"
        },
        {
          "name": "event",
          "type": "varint"
        },
        {
          "name": "state",
          "type": "u8"
        },
        {
          "name": "start",
          "type": "u64"
        },
        {
          "name": "windowStart",
          "type": "u64"
        },
        {
          "name": "windowEnd",
          "type": "u64"
        }
      ]
    }
  ],
  "ui": {
    "panel": {
      "width": 420,
      "height": 560
    }
  }
}
