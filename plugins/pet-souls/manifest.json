{
  "id": "pet-souls",
  "name": "Pet Soul Tracker",
  "version": "0.4.0",
  "apiVersion": 1,
  "author": "A2 Tools",
  "description": "Souls still needed to raise each pet, from the game's own pet data, and where each pet's souls drop.",
  "permissions": ["storage", "events:character", "decoder:pet-list", "decoder:soul-gained", "decoder:level-up"],
  "decoders": [
    {
      "name": "pet-list",
      "opcode": "00 90",
      "fields": [
        { "type": "skip:4" },
        { "name": "levels", "type": "list", "count": "varint", "fields": [
          { "name": "pet", "type": "u32" }, { "type": "skip:4" }, { "name": "level", "type": "u32" }
        ] },
        { "name": "points", "type": "list", "count": "varint", "fields": [
          { "name": "pet", "type": "u32" }, { "name": "points", "type": "u32" }
        ] }
      ]
    },
    {
      "name": "soul-gained",
      "opcode": "0D 90",
      "immediate": true,
      "fields": [ { "type": "skip:1" }, { "name": "pet", "type": "u32" }, { "name": "amount", "type": "u32" } ]
    },
    {
      "name": "level-up",
      "opcode": "14 90",
      "immediate": true,
      "fields": [ { "type": "skip:2" }, { "name": "pet", "type": "u32" }, { "name": "level", "type": "u32" } ]
    }
  ],
  "ui": { "panel": { "width": 380, "height": 520 } }
}
